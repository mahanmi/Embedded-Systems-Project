=== schema ===
CREATE TABLE detections(  id         INTEGER PRIMARY KEY AUTOINCREMENT,  ts_wall    REAL    NOT NULL,  persons    INTEGER NOT NULL,  cpu_temp_c REAL,  fps        REAL,  guard_mode INTEGER NOT NULL DEFAULT 0,  emailed    INTEGER NOT NULL DEFAULT 0,  note       TEXT);
CREATE TABLE sqlite_sequence(name,seq);
CREATE INDEX idx_det_ts ON detections(ts_wall);
CREATE TABLE stats(  k TEXT PRIMARY KEY,  v REAL NOT NULL DEFAULT 0);
CREATE TRIGGER trg_detections_ring AFTER INSERT ON detections BEGIN   DELETE FROM detections WHERE id <= NEW.id - 1000; END;

