// ============================================================================
//  polkit rule -- /etc/polkit-1/rules.d/49-guardian.rules
//
//  The guardian daemon runs unprivileged but needs two privileged actions:
//  restarting its own detector (software watchdog, part 4-3) and rebooting the
//  board (the API's `reboot` command, part 2-a).
//
//  A NOPASSWD sudoers entry would grant far more than that. This rule instead
//  authorises exactly those two operations, for exactly the `guardian` user,
//  and only for units belonging to this project -- everything else still
//  requires normal authentication.
// ============================================================================

polkit.addRule(function (action, subject) {
    if (subject.user !== "guardian")
        return undefined;   // fall through to the default policy

    // --- restart our own units (watchdog / API command) ---
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit === "guardian-vision.service" ||
            unit === "guardian-api.service") {
            var verb = action.lookup("verb");
            if (verb === "restart" || verb === "try-restart" ||
                verb === "start"   || verb === "stop") {
                return polkit.Result.YES;
            }
        }
        return undefined;
    }

    // --- reboot the board (POST /api/v1/command {"cmd":"reboot"}) ---
    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions") {
        return polkit.Result.YES;
    }

    return undefined;
});
