# =============================================================================
#  TEMPLATE ONLY -- copy to /etc/guardian/secrets.env and fill in.
#
#      sudo install -m 0640 -o root -g guardian \
#           secrets.env.example /etc/guardian/secrets.env
#      sudo nano /etc/guardian/secrets.env
#
#  This file is read by systemd (EnvironmentFile=) and the values land in the
#  daemon's environment, where config.c picks them up with getenv(). Nothing
#  here is ever committed: the real file is root:guardian 0640 and lives only
#  on the board.
#
#  The project brief forbids hard-coded passwords and API keys on the device.
#  The daemon enforces that by refusing to start when any of these is absent.
# =============================================================================

# Gmail application password (16 characters, no spaces).
# Generate one at https://myaccount.google.com/apppasswords -- it requires
# 2-step verification to be enabled on the account. This is NOT the account
# password, and it can be revoked independently.
GUARDIAN_SMTP_PASS=xxxxxxxxxxxxxxxx

# Password for the dedicated `guardian` user on the Mosquitto broker.
# Must match what was set with:  mosquitto_passwd -c passwd guardian
GUARDIAN_MQTT_PASS=change-me

# Bearer token guarding the privileged API commands (reboot, set_fps, ...).
# At least 16 characters; generate with:  openssl rand -hex 24
GUARDIAN_API_TOKEN=change-me-to-a-long-random-string
