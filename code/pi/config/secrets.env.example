# =============================================================================
#  TEMPLATE ONLY -- copy to /etc/guardian/secrets.env and fill in.
#
#      sudo install -m 0640 -o root -g guardian \
#           secrets.env.example /etc/guardian/secrets.env
#      sudo nano /etc/guardian/secrets.env
#
#  This file is read by systemd (EnvironmentFile=) and the values land in the
#  daemon's environment, where config.c picks them up with getenv(). Nothing
#  here is ever committed: the real file is root:guardian 0640 and lives only
#  on the board.
#
#  The project brief forbids hard-coded passwords and API keys on the device.
#  The daemon enforces that by refusing to start when any of these is absent.
# =============================================================================

# Gmail application password (16 characters, no spaces).
# Generate one at https://myaccount.google.com/apppasswords -- it requires
# 2-step verification to be enabled on the account. This is NOT the account
# password, and it can be revoked independently.
GUARDIAN_SMTP_PASS=xxxxxxxxxxxxxxxx

# Password for the dedicated `guardian` user on the Mosquitto broker.
# Must match what was set with:  mosquitto_passwd -c passwd guardian
GUARDIAN_MQTT_PASS=change-me

# Bearer token guarding the privileged API commands (reboot, set_fps, ...).
# At least 16 characters; generate with:  openssl rand -hex 24
GUARDIAN_API_TOKEN=change-me-to-a-long-random-string

# Password for the RTSP camera / DVR account named by `camera_user` in
# guardian.conf. Only needed when `camera_source = rtsp`; the detector refuses
# to start without it rather than silently falling back to another source.
#
# It lives here, and not in guardian.conf, because the RTSP URL embeds the
# password -- so the URL itself is a credential and must never be written to a
# config file, a log line or a journal entry. guardian_vision.py logs a
# redacted form (rtsp://admin:***@host/...) for exactly this reason.
GUARDIAN_CAM_PASS=change-me

# Telegram bot token, issued by @BotFather and revocable there at any time.
# Shaped <digits>:<35 or so characters>, e.g. 1234567890:AAxxxxxxxx...
#
# Same reasoning as the RTSP password above, one step further: the Bot API puts
# the token in the request PATH (https://api.telegram.org/bot<TOKEN>/sendPhoto),
# so the URL is the credential. telegram.c builds that URL at call time and
# never passes it to a log call.
#
# Unlike the three secrets above, this one is optional: without it the daemon
# logs that the Telegram channel is disabled and keeps running on email alone.
GUARDIAN_TELEGRAM_TOKEN=change-me

# Password for the SOCKS5 proxy named by `telegram_proxy_url` in guardian.conf.
# Only needed when that key is set. It is passed to libcurl as a separate
# proxy credential rather than spliced into the proxy URL, so that the URL in
# guardian.conf stays safe to commit.
GUARDIAN_TELEGRAM_PROXY_PASS=change-me
