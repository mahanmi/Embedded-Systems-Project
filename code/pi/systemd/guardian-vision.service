# =============================================================================
#  Image-processing service (part 3-a)
#
#  ORDERING RATIONALE
#  ------------------
#  Requires=guardian-ingest.socket  -- hard dependency: without the frame
#      source there is nothing to detect, so systemd must not even attempt to
#      start this unit if the socket cannot be bound, and stopping the socket
#      stops this too.
#  After=guardian-ingest.socket     -- ordering: bind the port before the
#      detector tries to accept on it.
#
#  This is the unit the brief's example refers to ("image processing after the
#  camera is ready"). It deliberately sits BEFORE guardian.service, because the
#  C daemon's watchdog starts judging frame freshness as soon as it is up.
# =============================================================================
[Unit]
Description=Guardian image processing (OpenCV MobileNet-SSD person detection)
Documentation=file:/opt/guardian/README
Requires=guardian-ingest.socket
After=guardian-ingest.socket network-online.target
Wants=network-online.target
# Restart forever. A permanently unplugged capture host must not disable the
# unit, because the C daemon's watchdog (part 4-3) also drives restarts here.
StartLimitIntervalSec=0

[Service]
Type=simple
User=guardian
Group=guardian

ExecStart=/usr/bin/python3 /opt/guardian/bin/guardian_vision.py \
    --config /etc/guardian/guardian.conf \
    --model-dir /opt/guardian/models \
    --listen-fd 3

# Inherit the already-bound listening socket from guardian-ingest.socket.
Sockets=guardian-ingest.socket

Restart=always
RestartSec=3

# Thread count is NOT set here. It used to be OPENCV_NUM_THREADS=3, which
# silently disagreed with cv_threads in guardian.conf -- the detector calls
# cv2.setNumThreads() at startup and that wins, so the unit's value looked
# authoritative while having no effect. One knob, in the config file.
Environment=PYTHONUNBUFFERED=1

# Set GUARDIAN_DEBUG_CONF=1 to log the unthresholded best person score, the ROI
# in use and the boxes that survived, per inference. Without it the only
# observable is the thresholded count, which cannot tell "scored 0.44 and was
# rejected" apart from "saw nothing" -- and those need different fixes.

# Needed for camera_source=rtsp: GUARDIAN_CAM_PASS is the camera account's
# password, and it is deliberately absent from guardian.conf because the RTSP
# URL embeds it, making the URL itself a credential. Same root:guardian 0640
# file the C daemon already uses.
#
# `-` prefix: the unit still starts when the file is missing, which keeps the
# socket/webcam path working on a board that has no camera credentials at all.
# When camera_source=rtsp the detector checks for the variable itself and exits
# with a clear message rather than starting blind.
EnvironmentFile=-/etc/guardian/secrets.env

# --- sandboxing ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/log/guardian /dev/shm
# The detector needs /dev/video* only if a real camera is ever attached.
DeviceAllow=char-video4linux rw
SupplementaryGroups=video

# 1 GB of RAM total: cap the detector so an OpenCV leak cannot take the board
# down with it. systemd will restart it if the limit is hit.
MemoryMax=420M
MemoryHigh=380M

[Install]
WantedBy=multi-user.target
