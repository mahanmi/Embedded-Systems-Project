
=== password login as mahan ===
$ ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive -o StrictHostKeyChecking=no -o ConnectTimeout=10 mahan@192.168.100.26 true
mahan@192.168.100.26: Permission denied (publickey).
[exit 255]

=== root login ===
$ ssh -o BatchMode=yes -o ConnectTimeout=10 root@192.168.100.26 true
root@192.168.100.26: Permission denied (publickey).
[exit 255]

=== unknown account 'intruder' ===
$ ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive -o StrictHostKeyChecking=no -o ConnectTimeout=10 intruder@192.168.100.26 true
intruder@192.168.100.26: Permission denied (publickey).
[exit 255]

